# Datenbank (Pflicht: sichere Passwörter setzen)
DB_NAME=klausurwerk
DB_USER=klausurwerk
DB_PASS=
DB_ROOT_PASS=

# Gemeinsames Geheimnis App <-> Runner (Pflicht, z. B. openssl rand -hex 32)
RUNNER_TOKEN=

APP_PORT=9030
# Live-Wand: Verzeichnis für flüchtige Bilder und Live-Zustand (tmpfs, nicht ändern; Rückfall: Temp-Verzeichnis)
# LIVE_DIR=/run/klausurwerk-live
# Größe des tmpfs; je Raum mit Bildschirmfreigabe etwa 25 MB einplanen
LIVE_DIR_SIZE=256m
APP_ENV=production
BASE_URL=/
# Adressen oder CIDR-Bereiche der eigenen Reverse-Proxys (kommagetrennt). Nur von dort gelten
# X-Forwarded-For (Client-IP) und X-Forwarded-Proto (HTTPS für Cookies, QR-Codes, SEB-Prüfung).
TRUSTED_PROXIES=
# 1 = Cookies immer mit Secure-Flag ausliefern (HTTPS-Betrieb ohne passendes TRUSTED_PROXIES)
SECURE_COOKIES=
# Wartezeit auf Antworten des Runners in Sekunden
RUNNER_TIMEOUT=20
# Wartezeit auf die Datenbank beim Start in Sekunden
DB_WAIT_TIMEOUT=120

# Runner-Grenzen
RUNNER_MAX_PARALLEL=4
RUNNER_MAX_SECONDS=10
RUNNER_MAX_MEMORY_MB=256
RUNNER_MEM_LIMIT=2g
RUNNER_CPUS=2

# E-Mail (Anmeldecodes für Lehrkräfte)
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Klausurwerk

# Update-Prüfung für Admins (CHANGELOG.md des Repos). Leer = Standard, off = abgeschaltet.
UPDATE_CHECK_URL=

# Optional: fertige Images aus der GHCR statt lokal bauen
# APP_IMAGE=ghcr.io/theunknown-0/klausurwerk-app:latest
# RUNNER_IMAGE=ghcr.io/theunknown-0/klausurwerk-runner:latest
