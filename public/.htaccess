Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Statische Dateien direkt ausliefern (Verzeichnisse nicht: kein Listing)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Alles andere an den Front-Controller
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Gleiche Isolation wie die PHP-Antworten: Worker und WebAssembly
    # (Pyodide, sql.js) brauchen sie, damit SharedArrayBuffer verfügbar ist.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_mime.c>
    AddType application/wasm .wasm
    AddType text/javascript .mjs
</IfModule>

# Gebaute Bundles und Laufzeiten ändern sich nur mit einem Deploy; der
# Cache-Buster (?v=mtime) sorgt für frische Fassungen.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/wasm "access plus 30 days"
</IfModule>

php_value upload_max_filesize 20M
php_value post_max_size 24M
